# DocPilot — API Key Configuration
# Copy this file to .env and fill in your key(s).
# Only ONE key is needed. DocPilot picks Gemini first, then OpenAI, then falls back offline.

# ── OPTION 1: Google Gemini (RECOMMENDED — Free tier available)
# Get your key at: https://aistudio.google.com/apikey
# Free tier: 15 requests/min, 1,500 requests/day — plenty for testing
GEMINI_API_KEY=your-gemini-api-key-here

# ── OPTION 2: OpenAI (GPT-4o-mini — very affordable)
# Get your key at: https://platform.openai.com/api-keys
# Cost: ~$0.15 per 1 million input tokens (a few rupees per hundred invoices)
# OPENAI_API_KEY=your-openai-api-key-here
